Mods: {
	Fran: {
		Rarities.TeacherPrismaticRarity.DisplayName: Master-and-Disciple Prismatic

		Items: {
			Foreword: {
				DisplayName: Foreword
				Tooltip:
					'''
					Hello, and welcome to Fran!
					This mod is inspired by Fran and Teacher from the anime
					Reincarnated as a Sword, and is made and maintained by me alone.
					I hope to give this duo an adventure of their own in Terraria.

					I'd also like to share a few thoughts about their abilities:
					Animation and games express things in different ways.
					An ability that shines in a story may not fit Terraria's
					combat, exploration, or progression if brought over unchanged.
					So, while doing my best to preserve what makes these characters
					special, I will adapt, leave out, or redesign certain abilities
					to suit the game. Not every ability from the original will
					appear here, and those that do may work differently.

					I've poured everything I can into this mod as a solo creator,
					and I hope you enjoy it.
					Thank you for playing. May Fran and Teacher bring a little
					more joy to your journey. Have a wonderful adventure!
					'''
			}

			FransHeadwear: {
				DisplayName: Fran's Headwear
				Tooltip:
					'''
					Favorite this item while it is in your inventory to enter Fran Mode
					Fran Mode is identical to naming a character "Fran", "フラン", or "弗兰"
					Enables Fran's appearance framework, Black Cat Warrior Instinct, dash, ultimate, and Teacher
					The prototype currently uses a vanilla cat-ear icon
					'''
			}

			Teacher: {
				DisplayName: Teacher
				Tooltip:
					'''
					[Left Click] Cycle through multiple sword techniques; each technique acts together with your tactics
					[Right Click] Open the tactic wheel; click a tactic to equip or remove it
					Duplicate tactics may be equipped for a stronger effect
					'''
				UltimateLocked: "[Enter Hardmode to unlock the Ultimate: Black Heavenly Tiger - Absolute Flash]"
				UltimateTooltip:
					'''
					[Ultimate] When the gauge is full, press the ultimate key to unleash the Black Heavenly Tiger's power
					Execute a single target with a continuous rush of slashes
					'''
				TacticSelection: "[Tactics] Selected: {0}/{1}"
				FullLoadoutActive: "[Full Loadout] Active: {0}"
				FullLoadoutInactive: "[Full Loadout] Inactive"
				GoldenPrompt: Enter text
			}

			StrategyGuideBook: {
				DisplayName: Strategy Guide
				Tooltip:
					'''
					Left-click to open Teacher's tactic loadout guide
					Browse recommended setups for two, three, or four available tactic slots
					Right-click inside the guide or click the top-right button to close it
					'''
			}

			TeacherExcavationTool: {
				DisplayName: Teacher — Excavation Form
				Tooltip:
					'''
					Teacher reshapes itself into a restrained utility form for exploration
					Left click uses the pickaxe; right click uses the hamaxe
					Supports automatic reuse and vanilla Smart Cursor
					Its tool performance grows with world progression, but it cannot use Teacher's combat skills
					Granted automatically when you first obtain Teacher
					'''
			}

			VanillaBossProgressAdjuster: {
				DisplayName: Vanilla Boss Progress Adjuster
				Tooltip:
					'''
					Developer tool: use to open the vanilla-only boss progress panel
					Click a portrait to set or clear that world's defeated flag; footer buttons change whole phases
					Multiplayer changes are validated and applied by the server
					This changes progression flags only and does not undo permanent world conversion
					'''
			}

			TeacherArrivalDebugger: {
				DisplayName: Teacher Arrival Debugger
				Tooltip:
					'''
					Cheat-only developer tool; it has no recipe
					Left click to replay the full arrival near the cursor
					Bypasses the delay, surface and one-time eligibility checks
					Does not consume your character's normal arrival opportunity
					Reusable; each use creates a Teacher that anyone can pick up
					'''
			}

			FranDamageDebugger: {
				DisplayName: Teacher Damage Debugger
				Tooltip:
					'''
					Cheat-only developer tool; it has no recipe
					Left click to open the base-damage panel
					Favorite it in your inventory to enable its override
					Only Teacher's base item damage is replaced
					'''
			}
		}

		ToolProgression: {
			Current: Current stage: {0} | Pickaxe {1} · Axe {2}% · Hammer {3} · Reach +{4} · Use time {5}
			Next: Next evolution: {0}
			FinalStage: Final excavation form reached

			Stages: {
				Stage0: Initial Form
				Stage1: Evil-Ore Adaptation
				Stage2: Dungeon Excavation
				Stage3: Hardmode Reconstruction
				Stage4: Mechanical Analysis
				Stage5: Jungle Resonance
				Stage6: Temple Demolition
				Stage7: Lunar Final Form
			}

			Unlocks: {
				Stage1: Defeat the Eater of Worlds or Brain of Cthulhu
				Stage2: Defeat Skeletron
				Stage3: Defeat the Wall of Flesh and enter Hardmode
				Stage4: Defeat all three mechanical bosses
				Stage5: Defeat Plantera
				Stage6: Defeat Golem
				Stage7: Defeat the Moon Lord
			}
		}

		Buffs: {
			BlackCatWarriorBuff: {
				DisplayName: Black Cat Warrior Instinct
				Description: Immune to fall damage, improved night vision, +10% melee damage and attack speed
			}
		}

		Keybinds: {
			SkillWheel.DisplayName: Teacher Skill Wheel
			PotentialRelease.DisplayName: Black Heavenly Tiger Flash
			FranDash.DisplayName: Fran Dash
			MagicStoneCorridor.DisplayName: Teacher's Magic-Stone Corridor
		}

		UI: {
			UltimateCharge: Black Tiger: {0}%
			UltimateReady: BLACK TIGER READY
			PureSwordsmanship: Pure Swordsmanship Core
			PureSwordsmanshipDescription: Empty every lower slot to use pure swordsmanship. Teacher's four-part combo always remains; tactics are layered onto it rather than replacing it
			PureSwordsmanshipLine1: Empty every tactic slot to use pure swordsmanship
			PureSwordsmanshipLine2: Teacher's four-cut combo always remains
			TacticSlots: Tactic slots: {0}/{1}
			TacticControls: Left-click a wheel icon to equip | left-click an equipped icon below the wheel to remove | right-click again or open inventory to close
			TacticEquipped: Equipped: {0} x{1}
			TacticUnequipped: Removed: {0} (x{1} remaining)
		}

		StrategyGuide: {
			Title: Teacher Tactic Loadout Guide
			Subtitle: Full loadouts pursue a transformation; mixed loadouts run several first-layer mechanics together
			CurrentStatus: Current capacity: {0} slots | Viewing: {1}-slot loadouts
			CloseHint: Click a tab to preview another stage | Right-click inside the guide or click X to close
			FullLoadoutTitle: Full-loadout value at a glance
			FullLoadoutSummary: Major transformations: Telekinetic Catapult, Skill Taker, Magic Barrier, Blue Resonance, Pressurized Quickdraw, and Thor's Hammer | Thunder Chain is exceptional in rain | Multiple Body Creation has a gentler full bonus and mixes well

			Tabs: {
				Slots2: 2 slots
				Slots3: 3 slots
				Slots4: 4 slots
				Current: "{0} · current"
			}

			Page2: {
				Structure: Two slots offer two structures: a 2-slot full loadout for its transformation, or 1+1 for two first-layer mechanics. Full-loadout effects are cheapest here.

				Entry1: {
					Title: Telekinetic x2 | Effortless tracking
					Body: Mind cores gain persistent tracking and retargeting. This is the safest, least demanding route for stable ranged pressure.
				}

				Entry2: {
					Title: Skill Taker x2 | Melee reward
					Body: Teacher's blade must hit to launch the wisps. Sustained close combat can eventually raise vulnerability to 1.7x.
				}

				Entry3: {
					Title: Barrier x2 | Maximum forgiveness
					Body: Gain 15% damage reduction and 15 defense, then halve contact damage and add 35 life regeneration for a survival-first style.
				}

				Entry4: {
					Title: Blue x2 | Active sustain
					Body: Every swing creates a group of blue motes without a hit; blade hits still add more, so recovery no longer needs an initial target.
				}

				Entry5: {
					Title: Telekinetic + Taker | Balanced offense
					Body: Telekinesis pressures at range while Skill Taker amplifies damage after closing in. Both full-loadout transformations are sacrificed for flexibility.
				}

				Entry6: {
					Title: Barrier + Blue | Two safety nets
					Body: One layer reduces incoming damage and the other restores life. Neither is extreme, but the combination covers more kinds of danger.
				}
			}

			Page3: {
				Structure: Three slots allow a full 3, a focused 2+1, or a broad 1+1+1. In most situations, 2+1 is the best balance between strength and coverage.

				Entry1: {
					Title: Skill Taker x3 | Sustained pressure
					Body: The full loadout reaches the 1.7x ceiling, while two added layers accelerate growth and keep the mark alive longer.
				}

				Entry2: {
					Title: Blue x3 | Resonance on every swing
					Body: Each swing starts with a full mote group, and every enemy struck adds another group for active healing and strong crowd value.
				}

				Entry3: {
					Title: Taker x2 + Telekinetic | Range switching
					Body: Skill Taker grows faster while Telekinetic Catapult keeps its ranged sequence. It loses the 1.7x ceiling but does not demand constant proximity.
				}

				Entry4: {
					Title: Barrier x2 + Blue | Reliable sustain
					Body: Pair 15% damage reduction and 15 defense with healing motes. You trade Barrier's full bonus for recovery against non-contact damage.
				}

				Entry5: {
					Title: Multiple x2 + Quickdraw | Projectile offense
					Body: Add another phantom and lay compressed bursts at 60% of full frequency; non-full burst damage is also reduced to 80%, trading specialization for coverage.
				}

				Entry6: {
					Title: Telekinetic + Taker + Barrier | All-range
					Body: Ranged projectiles, close-range vulnerability, and basic defense all run together. No capstone, but every combat distance has an answer.
				}
			}

			Page4: {
				Structure: With four slots, favor a full 4, a 2+2, or a 2+1+1. A 3+1 is often awkward: it invests three slots in one tactic while losing its defining full-loadout transformation.

				Entry1: {
					Title: Telekinetic x4 | Tracking fire net
					Body: All three added cores gain long-range tracking and retargeting, creating the most stable sustained ranged route with minimal input demands.
				}

				Entry2: {
					Title: Skill Taker x4 | Melee limit
					Body: Vulnerability reaches its 1.7x ceiling in about four seconds and lasts longest, but repeated blade hits are required to earn that peak.
				}

				Entry3: {
					Title: Barrier x4 | Survival limit
					Body: Gain 25% damage reduction, 25 defense, halved contact damage, and 35 life regeneration by trading away ranged tactic support.
				}

				Entry4: {
					Title: Quickdraw x4 | Endless blade disc
					Body: The four-cut chain becomes a continuous blade disc. Hold left-click to spin and leave triple-duration compression vortices along the true blade path; release to coast to a stop.
				}

				Entry5: {
					Title: Taker x2 + Telekinetic + Blue | General offense
					Body: Faster vulnerability, ranged projectiles, and healing run together. It loses the 1.7x cap but minimizes ordinary combat downtime.
				}

				Entry6: {
					Title: Barrier x2 + Blue x2 | Stable survival
					Body: Moderate mitigation combines with extra motes, covering sustained damage and team recovery without relying on Barrier's contact capstone.
				}

				Entry7: {
					Title: Multiple x2 + Quickdraw x2 | Dual projectiles
					Body: Phantom count and Quickdraw stacks improve together, but non-full Quickdraw still has 60% frequency and 80% stage damage. This is dual coverage, not blade-disc specialization.
				}

				Entry8: {
					Title: Telekinetic + Taker + Barrier + Blue | Universal
					Body: Four first-layer mechanics cover range, melee amplification, mitigation, and healing. It is the broadest setup, but has no specialization peak.
				}
			}
		}

		MainMenu.DisplayName: Fran · Reincarnated as a Sword

