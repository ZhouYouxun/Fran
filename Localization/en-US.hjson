			ShipCutterProjectile.DisplayName: Ship Cutter Projectile
			SkillTakerPhantom.DisplayName: Skill Taker Phantom
			SkillTakerSoul.DisplayName: Skill Taker Soul
			FranUltimateController.DisplayName: Black Heavenly Tiger Execution
			FranUltimateReadySigil.DisplayName: Ultimate Ready Sigil
			FranUltimateExecutionSeal.DisplayName: Ultimate Execution Seal
			FranUltimateStrikeBeat.DisplayName: Ultimate Strike Beat
			FranUltimateSpectatorBlade.DisplayName: Ultimate Spectator Blade
			TeacherSlashWave.DisplayName: Teacher Slash Wave
			TeacherSwing.DisplayName: Teacher Swing
			TelekineticCannonProjectile.DisplayName: Telekinetic Cannon Projectile
			ThorsHammerBolt.DisplayName: Thors Hammer Bolt
			ThorsHammerMarker.DisplayName: Thors Hammer Marker
			FlameFangAuraVisual.DisplayName: Flame Fang Aura Visual
			TeacherPiercingWave.DisplayName: Teacher Piercing Wave
			TeacherCrescentWave.DisplayName: Teacher Crescent Wave
			TeacherCompressionWave.DisplayName: Teacher Compression Wave
			TeacherStarlightMass.DisplayName: Teacher Starlight Mass
			FranDeathVisual.DisplayName: Fran Death Visual
			TeacherResonanceEcho.DisplayName: Teacher Resonance Echo
			FranHeartSeekerProjectile.DisplayName: Fran Heart Seeker Projectile
			TeacherSwingRebuild.DisplayName: Teacher Swing Rebuild
			FranWindField.DisplayName: Fran Wind Field
			FranTelekineticReturnBlade.DisplayName: Fran Telekinetic Return Blade
			FranSkillSealDetonation.DisplayName: Fran Skill Seal Detonation
			FranReplaySlash.DisplayName: Fran Replay Slash
			FranLightningBranches.DisplayName: Fran Lightning Branches
			FranHammerBeacon.DisplayName: Fran Hammer Beacon
			FranFireScar.DisplayName: Fran Fire Scar
			FranCompressedCut.DisplayName: Fran Compressed Cut
			FranBlueResonanceEcho.DisplayName: Fran Blue Resonance Echo
			FranBarrierCounterCut.DisplayName: Fran Barrier Counter Cut
			FranAutoBarrierProjectile.DisplayName: Fran Auto Barrier Projectile
			FranCompressionNode.DisplayName: Fran Compression Node
			FranRicochetLightning.DisplayName: Fran Ricochet Lightning
			FranTelekineticShell.DisplayName: Fran Telekinetic Shell
			FranSkillTakerWisp.DisplayName: Skill Taker Wisp
			FranTeacherPhantomBlade.DisplayName: Teacher Phantom Blade
			FranThunderDropVisual.DisplayName: Descending Thunder
			FranPressurizedTerraWave.DisplayName: Pressurized Terra Wave
			FranThorsHammerDrop.DisplayName: Thor's Hammer Drop
			FranCompressionAirburst.DisplayName: Fran Compression Airburst
			FranSpectatorPetalProjectile.DisplayName: Fran Spectator Petal Projectile
			FranSpectatorRibbonProjectile.DisplayName: Fran Spectator Ribbon Projectile
			FranTelekineticLineStrike.DisplayName: Fran Telekinetic Line Strike
			FranEvolutionEchoSlash.DisplayName: Fran Evolution Echo Slash
			FranEvolutionUnlockSigil.DisplayName: Fran Evolution Unlock Sigil
			FranMagicStoneAbsorptionVfx.DisplayName: Fran Magic Stone Absorption Vfx
			FranThunderGroundArcVisual.DisplayName: Fran Thunder Ground Arc Visual
		}
	}
}
