Mods: {
	Fran: {
		Items: {
			FransHeadwear: {
				DisplayName: Fran's Headwear
				Tooltip:
					'''
					Favorite this item while it is in your inventory to enter Fran Mode
					Fran Mode is identical to naming a character "Fran", "フラン", or "弗兰"
					Enables Fran's appearance framework, Black Cat Warrior Instinct, dash, ultimate, and Teacher
					The prototype currently uses a vanilla cat-ear icon
					'''
			}

			Teacher: {
				DisplayName: Teacher
				Tooltip:
					'''
					A legendary intelligent sword bound to Fran
					Hold left click: cycle through Sweep, Rising Slash, Lunge Thrust, and Heavy Finisher
					Hold right click to open the imprint wheel, then release it in a sector to bind that imprint into the four-part combo
					Press [c/C3B2F5:Magic-Stone Corridor] (default J) to allocate Self Evolution Points earned from boss battles
					Release right click in the wheel center to remove the imprint and return to pure swordsmanship
					The ultimate charges automatically over three minutes; press [c/8CDFFF:Ultimate] (default G) when full to begin the execution rush immediately
					Teacher follows behind Fran whenever another weapon is held
					A non-Fran character who actually owns Teacher may still use its combo and skill wheel; character passives remain exclusive to Fran Mode
					Teacher cannot be dropped, sold, researched, trashed, or left in storage; once bonded, it will always return
					Damage and available skills grow with world progression
					'''
			}

			TeacherExcavationTool: {
				DisplayName: Teacher — Excavation Form
				Tooltip:
					'''
					Teacher reshapes itself into a restrained utility form for exploration
					Left click uses the pickaxe; right click uses the hamaxe
					Supports automatic reuse and vanilla Smart Cursor
					Its tool performance grows with world progression, but it cannot use Teacher's combat skills
					Granted automatically the first time a bond with Teacher is established
					'''
			}

			VanillaBossProgressAdjuster: {
				DisplayName: Vanilla Boss Progress Adjuster
				Tooltip:
					'''
					Developer tool: use to open the vanilla-only boss progress panel
					Click a portrait to set or clear that world's defeated flag; footer buttons change whole phases
					Multiplayer changes are validated and applied by the server
					This changes progression flags only and does not undo permanent world conversion
					'''
			}
		}

		ToolProgression: {
			Current: Current stage: {0} | Pickaxe {1} · Axe {2}% · Hammer {3} · Reach +{4} · Use time {5}
			Next: Next evolution: {0}
			FinalStage: Final excavation form reached

			Stages: {
				Stage0: Initial Form
				Stage1: Evil-Ore Adaptation
				Stage2: Dungeon Excavation
				Stage3: Hardmode Reconstruction
				Stage4: Mechanical Analysis
				Stage5: Jungle Resonance
				Stage6: Temple Demolition
				Stage7: Lunar Final Form
			}

			Unlocks: {
				Stage1: Defeat the Eater of Worlds or Brain of Cthulhu
				Stage2: Defeat Skeletron
				Stage3: Defeat the Wall of Flesh and enter Hardmode
				Stage4: Defeat all three mechanical bosses
				Stage5: Defeat Plantera
				Stage6: Defeat Golem
				Stage7: Defeat the Moon Lord
			}
		}

		Buffs: {
			BlackCatWarriorBuff: {
				DisplayName: Black Cat Warrior Instinct
				Description: Immune to fall damage, improved night vision, +10% melee damage and attack speed
			}
		}

		Keybinds: {
			SkillWheel.DisplayName: Teacher Skill Wheel
			PotentialRelease.DisplayName: Black Heavenly Tiger Flash
			FranDash.DisplayName: Fran Dash
			MagicStoneCorridor.DisplayName: Teacher's Magic-Stone Corridor
		}

		UI: {
			UltimateCharge: Black Tiger: {0}%
			UltimateReady: BLACK TIGER READY
			PureSwordsmanship: Detach Tactical Imprint
			PureSwordsmanshipDescription: Detach the current tactical module; Teacher's four-part sword combo always remains intact
		}

		BossProgress: {
			Title: Vanilla Boss Progress Adjuster
			Defeated: defeated
			Undefeated: not defeated
			EntryHint: "{0} — {1}; click to toggle"

			Buttons: {
				PreHardmode: Pre-HM
				Hardmode: Hardmode
				All: All
				Invert: Invert
			}

			ButtonHints: {
				PreHardmode: Set or clear every pre-Hardmode vanilla boss flag
				Hardmode: Set or clear every Hardmode vanilla boss flag
				All: Set or clear all vanilla boss flags
				Invert: Invert every unique vanilla boss flag
			}

			Names: {
				KingSlime: King Slime
				EyeOfCthulhu: Eye of Cthulhu
				EaterOfWorlds: Eater of Worlds
				BrainOfCthulhu: Brain of Cthulhu
				QueenBee: Queen Bee
				Skeletron: Skeletron
				Deerclops: Deerclops
				WallOfFlesh: Wall of Flesh
				QueenSlime: Queen Slime
				Destroyer: The Destroyer
				Twins: The Twins
				SkeletronPrime: Skeletron Prime
				Plantera: Plantera
				Golem: Golem
				DukeFishron: Duke Fishron
				EmpressOfLight: Empress of Light
				LunaticCultist: Lunatic Cultist
				MoonLord: Moon Lord
			}
		}

		Notices: {
			IntroTitle: "[Fran Mode activated: Teacher has returned to your side]"
			IntroCombat: Hold left click for the four-part greatsword combo; Teacher floats behind you while another weapon is held
			IntroSkills: Hold right click to open the imprint wheel, then release it in a sector; the imprint joins the four-part combo automatically
			IntroEvolution: Participate in a boss victory to absorb its unique magic stone; press J to shape Teacher, Fran, and their long-term resonance in the Corridor
			IntroDash: When Fran Dash is bound, only that key triggers it; when unbound, double-tap left/right instead; equipped dashes take priority
			IntroPotential: The ultimate charges automatically over three minutes of active play; press G when full to begin Black Heavenly Tiger's execution rush immediately
		}

		Abilities: {
			Dash: {
				Line: "[Dash] Current progress: {0} | {1} | Effect: {2}"
				Progress: Unlocked from the beginning
				Effect: Speed 16, 12-tick duration, 50-tick base cooldown; Fran makes two visual rolls during the dash
				States: {
					Enabled: Enabled: no other dash is equipped
					Overridden: Disabled: an external dash is active and takes priority
					InactiveFranMode: Disabled: Fran Mode is not active
				}
			}

			Flight: {
				Line: "[Telekinetic Flight] Current progress: {0} | {1} | Effect: {2}"
				Progress: {
					Locked: Pre-Hardmode — not yet unlocked
					Tier1: Hardmode — Telekinetic Liftoff
					Tier2: All three mechanical bosses — Power Rebuild
					Tier3: Post-Plantera — Hover Mastery
					Tier4: Post-Golem — Telekinetic Final Form
					Infinite: Post-Empress of Light — Infinite Flight
				}
				States: {
					Enabled: Enabled: no functional wings are equipped
					Overridden: Disabled: functional wings are equipped and take priority
					Mounted: Paused: Telekinetic Flight does not stack with mounts
					Locked: Locked: automatically gained upon entering Hardmode
					InactiveFranMode: Disabled: Fran Mode is not active
				}
				Effects: {
					Locked: Counts as an innate pair of wings after entering Hardmode
					Finite: "{0} flight ticks ({1:0.00}s), horizontal speed {2}, acceleration multiplier {3}{4}"
					Infinite: "Infinite flight, horizontal speed {2}, acceleration multiplier {3}{4}"
					Hover: ", hold Down to hover"
					NoHover: ""
				}
			}
		}

		Evolution: {
			Title: Magic-Stone Corridor — Self Evolution
			OpenHint: Open the Magic-Stone Corridor (default J)
			Tooltip: Magic-Stone Corridor: {0} available / {1} boss stones absorbed; press J to allocate
			PointSummary: Available {0}   Invested {1}   Absorbed {2}   Current stage cap {3}
			Overview: Participate in a boss victory to absorb one unique magic stone. These paths shape base swordplay, Fran's dash, and Teacher–Fran coordination without changing tactical imprints or the Black Tiger ultimate.
			MagicStoneAcquired: Magic-stone imprint acquired — Self Evolution Point +1
			NodeUnlocked: Self Evolution: {0}
			ResetHold: Hold to respec (free)
			ResetEmpty: No evolution points invested
			ResetLocked: Cannot respec during combat

			Branches: {
				Teacher: Teacher — Self Evolution
				Fran: Fran — Black Cat Evolution
				Bond: Teacher and Fran — Resonance
			}

			Status: {
				None: Click to absorb this evolution (unavailable during bosses or the ultimate)
				Active: Absorbed and active
				AlreadyUnlocked: Already absorbed
				MissingPrerequisite: Absorb the preceding evolution first
				StageLocked: Requires character growth stage {0}
				NotEnoughPoints: Not enough Self Evolution Points; challenge a new boss
				InCombat: The corridor cannot be adjusted during a boss, the ultimate, or death
				InvalidNode: Invalid evolution node
			}

			Nodes: {
				EdgeCalibration: {
					DisplayName: Edge Calibration
					Description: Teacher's direct blade reach and hit range increase by 6%; tactical projectiles are unaffected.
				}

				ComboCalculation: {
					DisplayName: Combo Calculation
					Description: Landing the base sword stages in order empowers the next direct blade hit by 3%, 6%, then 9%; interruption resets it.
				}

				MagicStoneAnalysis: {
					DisplayName: Magic-Stone Analysis
					Description: Land all four base sword stages on the same boss within 6 seconds to analyze it for 8 seconds; direct blade hits gain 12 armor penetration.
				}

				SelfEvolution: {
					DisplayName: Self Evolution
					Description: Completing four direct blade hits stores one Evolution Echo; the next opening cut adds a close-range sword echo for 50% damage that cannot trigger an imprint.
				}

				CatStep: {
					DisplayName: Cat Step
					Description: Fran's dash cooldown falls from 50 to 42 ticks; the base combo timeout pauses while dashing.
				}

				AerialHunt: {
					DisplayName: Aerial Hunt
					Description: The manual dash supports eight directions, preferring movement input and then the cursor; double-tap dashes remain horizontal.
				}

				HuntingTempo: {
					DisplayName: Hunting Tempo
					Description: Touching an enemy during a dash stores one Hunter Tempo, shortening Teacher's next direct swing by 12%.
				}

				EvolvedFootwork: {
					DisplayName: Evolved Footwork
					Description: Dashing into a new target refunds 60% of the remaining cooldown; the same enemy can trigger this only once per 180 ticks.
				}

				MindSync: {
					DisplayName: Mind Sync
					Description: The base four-part combo timeout increases from 70 to 105 ticks.
				}

				SharedRhythm: {
					DisplayName: Shared Rhythm
					Description: Reaching the fourth base sword stage in sequence shortens that swing's duration by 12%.
				}

				ResonantPull: {
					DisplayName: Resonant Pull
					Description: Teacher's direct blade hits tug ordinary enemies toward the edge; bosses and fully knockback-immune enemies are unaffected.
				}

				OneAsSword: {
					DisplayName: One as Sword
					Description: Complete four direct blade hits without taking damage to gain 10% base swing speed and reach for 5 seconds; taking damage ends it.
				}
			}
		}

		Configs: {
			FranClientConfig: {
				DisplayName: Fran Client Settings

				HideUltimateGauge: {
					Label: Hide Black Tiger ultimate gauge
					Tooltip: The ultimate gauge is shown at the top center by default. Enable this only if you want to hide it.
				}

				AllowUltimateGaugeDragging: {
					Label: Allow ultimate gauge dragging
					Tooltip: Disabled by default. When enabled, drag the gauge with the left mouse button; its position is saved with the character.
				}
			}
		}

		Stages: {
			Current: Current growth: {0}
			Next: Next growth ({0}): {1}

			Stage1: {
				Unlock: Available from the beginning
				Summary: Stage I — Meeting and formation: four-part melee, Telekinetic Catapult, Skill Taker, and Magic Barrier
			}

			Stage2: {
				Unlock: Unlocks after defeating Skeletron
				Summary: Stage II — Floating Island and resonance: Multiple Body Creation and Blue Resonance unlock
			}

			Stage3: {
				Unlock: Unlocks after entering Hardmode
				Summary: Stage III — Seedrun civil war: Thunder Chain unlocks
			}

			Stage4: {
				Unlock: Unlocks after defeating all three mechanical bosses
				Summary: Stage IV — Road to Black Heavenly Tiger: Pressurized Quickdraw and Thor's Hammer unlock
			}
		}

		Skills: {
			TelekineticCatapult: {
				DisplayName: Telekinetic Catapult
				Description: The full sword combo remains intact; the first three cuts fire 2, 3, and 4 parallel telekinetic shells, while the fourth uses an infinitely piercing directional laser. In Hardmode, every cut also drops 2 to 3 planets from above; each planet brakes, accelerates, and explodes on its first enemy or tile impact
			}

			SkillTaker: {
				DisplayName: Skill Taker
				Description: Only direct sword hits trigger a purple technique burst and a theft stack; each hit splits two violet wisps that scatter before homing, up to four stacks with 10% sword damage each
			}

			MagicBarrier: {
				DisplayName: Magic Barrier
				Description: Maintains a two-layer barrier around the player; taking damage reduces it by 28%, spends one of five charges, and releases a retaliatory pulse before the barrier breaks and rebuilds
			}

			MultipleBodyCreation: {
				DisplayName: Multiple Body Creation
				Description: Every swing arrays two Teacher phantoms behind the player; after a brief hover they lock onto the cursor area and dash, while the fourth cut launches four in sequence
			}

			BlueResonance: {
				DisplayName: Blue Resonance
				Description: Every sword hit leaves a delayed blue repeat-cut; the fourth cut forms a three-note chord whose hits can periodically restore life
			}

			ThunderChain: {
				DisplayName: Thunder Chain
				Description: Every swing calls several ancient lightning arcs down over the cursor and adds automatic strikes above up to three nearby enemies; the fourth cut calls even more bolts
			}

			PressurizedQuickdraw: {
				DisplayName: Pressurized Quickdraw
				Description: Every swing releases a high-pressure wave using the Terra Blade beam form; it pierces without limit and gradually slows, while the fourth cut fires a smaller and faster finishing wave
			}

			ThorsHammer: {
				DisplayName: Thor's Hammer
				Description: After two complete four-cut rounds, the second round's fourth cut locks onto the enemy nearest the cursor; the summoning seal follows that target before Thor's Hammer pursues it at high speed and detonates a wide lightning-meteor impact
			}
		}

