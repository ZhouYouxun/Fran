Mods: {
	Fran: {
		Companion: {
			Title: Fran · 幻影伙伴战术
			Automatic: 自动适应战场
			Manual: 手动指定
			Current: 当前执行：{0}
			Hint: 指令将在连段结束后生效 · 右键或 Esc 关闭
			Hover: Fran【{0} · {1}】右键设置战术
			Dismiss: 取消召唤
			Locked: 【尚未解锁】
			ManualOnly: 【仅手动】
		}

		Items: {
			FranCompanionStaff: {
				DisplayName: 弗兰的约定
				Tooltip:
					'''
					召唤无敌的 Fran 幻影伙伴，始终手持师父，自带翅膀
					自动选择已解锁战术；靠近并右键 Fran 可手动指定
					魔力屏障仅能手动指定，连段结束后切换
					再次使用召回伙伴；右键使用本物品取消召唤
					每位玩家最多一名，不占召唤栏；伤害受世界进度与召唤伤害加成影响
					当前外观暂用钛金套，后续将换为 Fran 专属贴图
					'''
			}

			Foreword: {
				DisplayName: 前情提要
				Tooltip:
					'''
					你好，欢迎游玩《Fran》！
					这是一个以《转生成为魔剑》中的弗兰与师父为主题的模组，
					由我一个人制作并维护。
					希望能让这对搭档，在泰拉瑞亚里也拥有一段属于他们的冒险。

					关于原作中的技能，我也想提前和你聊几句：
					动画和游戏有着不同的表达方式。
					有些能力在故事里很精彩，直接搬进泰拉瑞亚，
					却未必适合这里的战斗、探索与成长节奏。
					因此，我会尽量保留角色的特色，同时根据游戏体验，
					对部分技能进行调整、取舍或重新设计。
					原作里的能力不一定都会加入，
					加入的能力也不一定与原作完全相同。

					这个模组倾注了我作为个人作者所能投入的全部心力，
					希望你能喜欢。
					谢谢你愿意来玩，也希望弗兰与师父能为你的旅途增添一些乐趣。
					那么，冒险愉快！
					'''
			}

			FransHeadwear: {
				DisplayName: 弗兰的头饰
				Tooltip:
					'''
					将本物品放在背包中并标记为收藏，
					即可进入“弗兰人物模式”
					效果与把角色命名为“Fran / フラン / 弗兰”完全相同
					开启弗兰外观、师父系统、冲刺与黑天虎大招
					人物被动：免疫摔落并获得夜视，
					并强化近战伤害与攻击速度
					测试版暂时使用原版猫耳图标
					'''
			}

			ShiFu: {
				DisplayName: 师父
				Tooltip:
					'''
					【左键】循环施展4种剑术，与已装配的战术同步进行
					【右键】呼出战术轮盘，点击战术装配或卸下
					重复装备相同战术可获得更强的效果
					合理搭配不同战术，可达成意想不到的效果
					'''
				UltimateLocked: 【进入困难模式后解锁大招：黑天虎-绝闪】
				UltimateTooltip: 手持师父时按下 {0} 键释放“黑天虎-绝闪”：对同一目标造成强力斩杀，大招期间无法切换手持武器
				TacticSelection: 当前战术：
				FullLoadoutActive: 【全选效果】触发 {0} 的全选效果：{1}
				FullLoadoutInactive: 【全选效果】未触发
				UnboundKey: 未绑定
				GoldenEvolutionRoad: 我们将再一次踏上进化的道路，一条没有尽头的道路
			}

			StrategyGuideBook: {
				DisplayName: 攻略书
				Tooltip:
					'''
					左键打开师父战术搭配攻略
					可分别查看拥有2、3、4格战术槽时的推荐配置
					界面中右键或点击右上角关闭
					'''
			}

			ShiFuExcavationTool: {
				DisplayName: 师父·开拓形态
				Tooltip:
					'''
					师父将自身塑造成适合开拓的工具形态
					左键作为镐使用；右键作为锤斧使用
					支持自动连续使用与原版智能光标
					性能随世界流程成长，但不会释放师父的战斗技能
					首次获得师父时自动获得
					'''
			}

			VanillaBossProgressAdjuster: {
				DisplayName: 原版Boss进度调整器
				Tooltip:
					'''
					开发工具：使用后打开仅包含原版Boss的进度面板
					点击头像可设置或清除当前世界的击败标记；
					底部按钮可批量调整阶段
					多人模式的修改请求由服务器校验并执行
					本工具只修改流程标记，
					不会逆转世界已经发生的永久地形转化
					'''
			}

			ShiFuArrivalDebugger: {
				DisplayName: 师父降临调试器
				Tooltip:
					'''
					作弊调试工具，无法合成
					左键在鼠标附近重播完整降临演出
					无视等待、地表和一次性机会条件
					不消耗角色的正式降临机会
					可反复使用，会生成可拾取的师父
					'''
			}

			FranDamageDebugger: {
				DisplayName: 师父伤害调试器
				Tooltip:
					'''
					作弊调试工具，无法合成
					左键打开基础伤害面板
					放在背包并收藏时生效
					仅覆盖师父的基础面板伤害
					'''
			}
		}

		Rarities.ShiFuPrismaticRarity.DisplayName: 师徒棱彩

		ToolProgression: {
			Current:
				'''
				当前阶段：{0}
				镐力 {1} · 斧力 {2}% · 锤力 {3}
				距离 +{4} · 使用时间 {5}
				'''
			Next: 下一次成长：{0}
			FinalStage: 已达到最终开拓形态

			Stages: {
				Stage0: 初始形态
				Stage1: 邪恶矿脉适应
				Stage2: 地牢开拓
				Stage3: 困难模式重构
				Stage4: 机械解析
				Stage5: 丛林共鸣
				Stage6: 神庙破拆
				Stage7: 月面终型
			}

			Unlocks: {
				Stage1: 击败世界吞噬怪或克苏鲁之脑
				Stage2: 击败骷髅王
				Stage3: 击败血肉墙并进入困难模式
				Stage4: 击败全部三个机械Boss
				Stage5: 击败世纪之花
				Stage6: 击败石巨人
				Stage7: 击败月亮领主
			}
		}

		Buffs: {
			BlackCatWarriorBuff: {
				DisplayName: 黑猫族的战士本能
				Description: 免疫摔落、获得夜视，近战伤害与攻击速度各提高10%
			}
		}

		Keybinds: {
			SkillWheel.DisplayName: 师父技能轮
			PotentialRelease.DisplayName: 黑天虎·绝闪
			FranDash.DisplayName: 弗兰冲刺
			MagicStoneCorridor.DisplayName: 师父的魔石回廊
		}

		UI: {
			UltimateCharge: 黑天虎：{0}%
			UltimateReady: 黑天虎·绝闪 READY
			PureSwordsmanship: 纯剑术核心
			PureSwordsmanshipDescription:
				'''
				下方槽位全部卸下后即为纯剑术；
				四段师父剑术始终保留，
				战术只会叠加到剑术之上
				'''
			PureSwordsmanshipLine1: 卸下全部战术后启用纯剑术
			PureSwordsmanshipLine2: 四段师父剑术始终保留
			TacticSlots: 战术槽位：{0}/{1}
			TacticControls:
				'''
				左键星轮图标装配｜
				左键轮盘下方已装配图标卸下｜
				再次右键或打开背包关闭
				'''
			TacticEquipped: 已装配：{0} ×{1}
			TacticUnequipped: 已卸下：{0}（剩余×{1}）
		}

		StrategyGuide: {
			Title: 师父战术搭配攻略
			Subtitle: 全选追求质变，混搭追求多套首层机制同时运转
			CurrentStatus: 当前已开放{0}格｜正在查看{1}格配置
			CloseHint: 点击上方分页查看其他阶段｜界面中右键或点击 × 关闭
			FullLoadoutTitle: 全选价值速查
			FullLoadoutSummary: 强质变：念动弹射、技能夺取者、魔力屏障、蝶变共鸣、雷链、压缩居合、雷神之锤｜多重分体的全选奖励较温和，更适合参加混搭

			Tabs: {
				Slots2: 2格配置
				Slots3: 3格配置
				Slots4: 4格配置
				Current: "{0} · 当前阶段"
			}

			Page2: {
				Structure: 2格只有两种结构：2格全选获得完整质变，或1+1同时启动两套首层机制。此时取得全选的成本最低。

				Entry1: {
					Title: 念动×2｜安逸追踪
					Body: 凝念核数量增加，形成持续追踪阵列。操作压力最低，适合稳定、安全的远距离输出。
				}

				Entry2: {
					Title: 夺取×2｜近战高回报
					Body: 必须由剑体命中启动夺取灵弹；持续贴身攻击后易伤最高达到1.7倍。
				}

				Entry3: {
					Title: 屏障×2｜极限容错
					Body: 获得15%减伤与15防御，再取得接触伤害减半和生命回复+35，彻底偏向生存。
				}

				Entry4: {
					Title: 蝶变×2｜主动续航
					Body: 每刀无条件产生一组共鸣蝴蝶；剑体命中敌人后还会继续追加，恢复不再依赖先命中。
				}

				Entry5: {
					Title: 念动+夺取｜均衡进攻
					Body: 念动负责远处压制，夺取负责近身后放大伤害；牺牲两边的全选质变换取适应性。
				}

				Entry6: {
					Title: 屏障+蝶变｜双重保险
					Body: 一层屏障承受伤害，一层蝶变恢复生命。单项不极端，但比单一防御机制更全面。
				}
			}

			Page3: {
				Structure: 3格可选3格全选、2+1主辅配置或1+1+1全功能配置。一般情况下，2+1是强度与功能最均衡的结构。

				Entry1: {
					Title: 夺取×3｜持续压制
					Body: 全选取得1.7倍易伤上限，两层叠加又让成长更快、标记更久，适合持续近战输出。
				}

				Entry2: {
					Title: 蝶变×3｜挥刀即共鸣
					Body: 每次挥刀先产生完整共鸣蝴蝶群，命中每个敌人还会各追加一组，兼顾主动治疗和群体收益。
				}

				Entry3: {
					Title: 夺取×2+念动｜攻守距离切换
					Body: 夺取获得更快成长，念动保留远程弹幕编排。无法达到1.7倍，但不必始终贴身作战。
				}

				Entry4: {
					Title: 屏障×2+蝶变｜稳健续航
					Body: 15%减伤和15防御搭配蝶变治疗；放弃屏障全选，换来应对非接触伤害的恢复能力。
				}

				Entry5: {
					Title: 多重×2+压缩｜弹幕进攻
					Body: 提升固定分身的伤害，再以全选前60%的频率沿挥刀轨迹铺设压缩爆点；压缩爆点伤害同时降至80%，以覆盖换取专精峰值。
				}

				Entry6: {
					Title: 念动+夺取+屏障｜全距离通用
					Body: 远程弹幕、近战易伤和基础防御同时启用。没有全选质变，但任何战斗距离都有作用。
				}
			}

			Page4: {
				Structure: 4格优先考虑4格全选、2+2或2+1+1。3+1通常最尴尬：已经投入三格，却刚好失去最关键的全选质变。

				Entry1: {
					Title: 念动×4｜追踪火力网
					Body: 三层额外念核组成密集追踪阵列，是最省操作、最稳定的持续远程路线。
				}

				Entry2: {
					Title: 夺取×4｜近战极限
					Body: 约4秒成长至最高1.7倍易伤，标记也最持久。必须持续用剑体命中，风险和回报都最高。
				}

				Entry3: {
					Title: 屏障×4｜生存极限
					Body: 25%减伤、25防御、接触伤害减半并获得生命回复+35；以远程战术能力换取最高容错。
				}

				Entry4: {
					Title: 压缩×4｜永续刀盘
					Body: 四段剑术彻底转化为持续回旋刀盘；按住左键不断旋转并沿真实剑路留下三倍持久的聚合旋风，松手后惯性停转。
				}

				Entry5: {
					Title: 夺取×2+念动+蝶变｜通用进攻
					Body: 易伤成长、远程弹幕和治疗同时存在。没有1.7倍上限，但日常输出最全面、空档最少。
				}

				Entry6: {
					Title: 屏障×2+蝶变×2｜稳定生存
					Body: 以中等减伤配合更多共鸣蝴蝶，不依赖屏障全选的接触减伤，也能处理持续受伤和队友恢复。
				}

				Entry7: {
					Title: 多重×2+压缩×2｜双重弹幕
					Body: 分身伤害和压缩叠层同时增强，但非全选压缩仍只有60%频率与80%阶段伤害；这是双机制覆盖，而非刀盘专精。
				}

				Entry8: {
					Title: 念动+夺取+屏障+蝶变｜万用配置
					Body: 四套首层机制同时运行，覆盖远程、近战增伤、减伤和治疗；最全面，但没有任何专精峰值。
				}
			}
		}

		MainMenu.DisplayName: 弗兰 · 转生成为魔剑

