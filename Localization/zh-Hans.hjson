			Disabled: 状态：收藏后才会启用
		}

		Notices: {
			ShiFuArrivalPickup: 靠近，拾起师父
			IntroTitle: 【弗兰人物模式已启动】
			IntroCombat: 持续左键使用四段大剑连击
			IntroSkills:
				'''
				右键打开或关闭战术轮盘；
				左键上方图标可重复装配，
				左键下方槽位卸下；
				背包打开时轮盘自动关闭
				'''
			IntroEvolution:
				'''
				实际参与Boss击杀可吸收独立魔石；
				按J打开魔石回廊，
				决定师父、弗兰与师徒共鸣的长期进化方向
				'''
			IntroDash:
				'''
				已绑定弗兰冲刺键时仅按该键冲刺；
				未绑定时双击左右方向键冲刺；
				其他装备冲刺优先
				'''
			IntroPotential:
				'''
				大招能量会随在线时间自动积攒三分钟；
				满值后手持师父并按G发动黑天虎连续斩杀，大招期间无法切换手持武器
				'''
		}

		Abilities: {
			Dash: {
				Bound: 【冲刺】按下 {0} 键进行强力冲刺（仅在未装配冲刺道具时有效）
				Unbound: 【冲刺】双击左右键进行强力冲刺（仅在未装配冲刺道具时有效）
			}

			Flight: {
				Locked: 【飞行】进入困难模式来解锁飞行
				WingsEquipped: 【飞行】玩家已装备翅膀，默认关闭念动飞行
				Enabled: 【飞行】已启用自动飞行（仅在未装配翅膀且在困难模式时有效）
			}
		}

		Evolution: {
			Title: 魔石回廊·自我进化
			OpenHint: 打开魔石回廊（默认J）
			Tooltip: 【魔石成长】按魔石回廊键开启
			PointSummary: 可用 {0}　已投入 {1}　累计 {2}　当前阶段上限 {3}
			Overview:
				'''
				点数由当前世界的Boss进度自动决定。
				中央核心向上、左下、右下展开师父、
				弗兰与师徒共鸣三组星座；
				指向星点查看效果。
				'''
			MagicStoneAcquired: 获得魔石刻印·自我进化点 +{0}
			NodeUnlocked: 自我进化：{0}
			ResetFree: ✦ 单击免费重置 ✦
			ResetEmpty: 尚未投入进化点
			ResetLocked: 战斗中不能洗点

			Branches: {
				ShiFu: 师父·自我进化
				Fran: 弗兰·黑猫进化
				Bond: 师徒·共鸣
			}

			Status: {
				None: 点击吸收此进化（Boss战和大招期间不可操作）
				Active: 已吸收并生效
				AlreadyUnlocked: 已吸收
				MissingPrerequisite: 需要先吸收前置进化
				StageLocked: 需要到达人物成长第{0}阶段
				NotEnoughPoints: 自我进化点不足；继续挑战新的Boss
				InCombat: Boss战、大招或死亡期间不能调整魔石回廊
				InvalidNode: 无效的进化节点
			}

			Nodes: {
				EdgeCalibration: {
					DisplayName: 锋刃校准
					Description:
						'''
						师父本体剑刃的攻击距离与判定范围提高6%；
						不强化技能弹幕。
						'''
				}

				ComboCalculation: {
					DisplayName: 连击演算
					Description:
						'''
						按顺序命中四段基础剑术时，
						下一段剑刃直击伤害依次提高3%、6%、9%；
						中断后重置。
						'''
				}

				MagicStoneAnalysis: {
					DisplayName: 魔石解析
					Description:
						'''
						6秒内以四段基础剑术依次命中同一Boss，
						使其被解析8秒；剑刃直击获得12点护甲穿透。
						'''
				}

				SelfEvolution: {
					DisplayName: 自我进化
					Description:
						'''
						完成四段剑刃直击后储存一次进化回响；
						下一轮第一剑追加50%伤害的近距离剑影，
						且不会触发战术术式。
						'''
				}

				CatStep: {
					DisplayName: 猫步
					Description:
						'''
						弗兰冲刺冷却由50帧降至42帧；
						冲刺期间暂停基础连击的中断计时。
						'''
				}

				AerialHunt: {
					DisplayName: 立体狩猎
					Description:
						'''
						主动冲刺键支持八方向冲刺：
						优先采用方向输入，无输入时指向鼠标；
						双击方向键仍保持水平冲刺。
						'''
				}

				HuntingTempo: {
					DisplayName: 猎场连携
					Description:
						'''
						冲刺接触敌人后储存一次猎手节奏；
						下一次师父本体挥砍的持续时间缩短12%。
						'''
				}

				EvolvedFootwork: {
					DisplayName: 进化之足
					Description:
						'''
						冲刺命中新目标时返还当前剩余冷却的60%；
						同一敌人180帧内只能触发一次。
						'''
				}

				MindSync: {
					DisplayName: 心念同步
					Description: 基础四段连击的中断时间由70帧延长至105帧。
				}

				SharedRhythm: {
					DisplayName: 共同步调
					Description:
						'''
						按顺序进入第四段基础剑术时，
						该段挥剑持续时间缩短12%。
						'''
				}

				ResonantPull: {
					DisplayName: 共鸣牵引
					Description:
						'''
						师父本体剑刃命中普通敌人时，
						将其小幅拉向剑锋；
						Boss和完全抗击退目标不受影响。
						'''
				}

				OneAsSword: {
					DisplayName: 人剑一体
					Description:
						'''
						不受伤完成四段剑刃直击后，
						基础挥剑速度与剑刃范围提高10%，持续5秒；
						受伤立即结束。
						'''
				}

				ArcaneCirculation: {
					DisplayName: 术式循环
					Description:
						'''
						携带师父时魔力消耗降低8%；
						师父本体剑刃的距离在锋刃校准基础上
						再提高4%。
						'''
				}

				DeeperAnalysis: {
					DisplayName: 深层解析
					Description:
						'''
						已解析Boss承受剑刃直击时的护甲穿透
						由12提高至18；进化回响伤害由50%提高至70%。
						'''
				}

				SwordSaintReasoning: {
					DisplayName: 剑圣演算
					Description:
						'''
						师父本体剑刃直击伤害提高6%；
						连击演算的三段增幅由3%/6%/9%
						提高至4%/8%/12%。
						'''
				}

				FelineReflex: {
					DisplayName: 猫之反射
					Description:
						'''
						弗兰冲刺冷却由42帧进一步降至38帧；
						携带师父时移动速度提高5%。
						'''
				}

				SkyHunter: {
					DisplayName: 天空猎手
					Description:
						'''
						弗兰主动冲刺速度提高10%，
						八方向冲刺更适合空中追击与脱离。
						'''
				}

				PredatorSight: {
					DisplayName: 捕食者之眼
					Description: 冲刺接触伤害由技能基础伤害的120%提高至140%。
				}

				PhantomStep: {
					DisplayName: 幻影步
					Description:
						'''
						每次主动冲刺额外获得4帧碰撞伤害免疫，
						使贴身穿越敌人更加稳定。
						'''
				}

				BlackCatAwakening: {
					DisplayName: 黑猫觉醒
					Description:
						'''
						冲刺冷却降至34帧、总速度增幅提高至15%、
						接触伤害提高至150%；
						进化之足返还75%冷却，
						猎手节奏缩短下一剑18%。
						'''
				}

				SharedMana: {
					DisplayName: 魔力共享
					Description: 携带师父时最大魔力提高20。
				}

				SharedVision: {
					DisplayName: 视界共享
					Description: 基础四段连击的中断时间由105帧进一步延长至125帧。
				}

				HarmonicGuard: {
					DisplayName: 共鸣守护
					Description: 携带师父时获得3点防御与2%伤害减免。
				}

				SoulBridge: {
					DisplayName: 灵魂桥梁
					Description: 共鸣牵引对普通敌人的牵引强度提高40%。
				}

				SynchronizedVolley: {
					DisplayName: 同步齐射
					Description:
						'''
						携带师父时魔法伤害提高6%，
						强化师父释放的战术术式与弹幕。
						'''
				}

				LimitResonance: {
					DisplayName: 极限共鸣
					Description: 黑天虎大招能量的自然积攒速度提高20%。
				}

				MutualGrowth: {
					DisplayName: 共同成长
					Description:
						'''
						人剑一体的挥剑速度与剑刃范围增幅
						由10%提高至12%，持续时间由5秒延长至7秒。
						'''
				}

				EternalContract: {
					DisplayName: 永恒契约
					Description:
						'''
						携带师父时所有伤害提高5%，
						并额外获得20最大魔力与3点防御。
						'''
				}
			}
		}

		Configs: {
			FranClientConfig: {
				DisplayName: 弗兰客户端设置

				EnablePlayerTextureReplacement: {
					Label: "[i:FamiliarShirt] 启用弗兰人物贴图替换"
					Tooltip:
						'''
						默认开启；人物贴图完成后由此统一控制
						弗兰外观替换，当前仅预留开关
						'''
				}

				EnableFranVoice: {
					Label: "[i:Megaphone] 启用弗兰配音"
					Tooltip:
						'''
						默认开启；统一控制弗兰的受伤、睡眠
						及后续人物语音，缺少音频时自动保持静默
						'''
				}

				EnableCustomMainMenu: {
					Label: "[i:WorldGlobe] 启用弗兰主菜单界面"
					Tooltip:
						'''
						默认开启；允许在主菜单主题切换中使用
						弗兰横屏主视觉与下落火焰粒子
						'''
				}

				EnableCustomFont: {
					Label: "[i:Book] 启用自定义字体"
					Tooltip: 默认关闭；开启后统一控制弗兰自定义字体替换
				}

				EnableModIconFlicker: {
					Label: "[i:FallenStar] 启用模组图标闪烁"
					Tooltip: 默认开启；关闭后模组列表中的Fran图标恢复为完全静态
				}

				EnableVideoPlayback: {
					Label: "[i:MusicBox] 启用剧情视频播放"
					Tooltip:
						'''
						默认开启；后续加入视频资源后由此允许
						客户端播放，当前没有视频时
						不会执行任何操作
						'''
				}

				EnableFloatingShiFuVisual: {
					Label: "[i:MagicMirror] 显示背包中的师父"
					Tooltip:
						'''
						默认关闭；开启后，当师父位于背包中
						且当前手持其他物品时，师父会浮在玩家身后
						'''
				}

				HoldSkillWheelToOpen: {
					Label: "[i:Cog] 将技能轮盘更改为长按触发"
					Tooltip:
						'''
						默认关闭；关闭时点击技能轮盘按键打开，
						再点一次关闭。开启后必须按住该按键
						才会显示技能轮盘，松开后自动关闭
						'''
				}

				HideUltimateGauge: {
					Label: "[i:InvisibilityPotion] 隐藏黑天虎大招能量条"
					Tooltip:
						'''
						大招能量条默认显示在屏幕最顶端中央；
						仅在不想显示时开启此项
						'''
				}

				AllowUltimateGaugeDragging: {
					Label: "[i:Toolbox] 允许拖动大招能量条"
					Tooltip:
						'''
						默认关闭；开启后可用鼠标左键
						直接拖动能量条，位置会随角色存档保存
						打开背包或自动暂停时也可拖动
						'''
				}
			}
		}

		Stages: {
			Current:
				'''
				当前成长：
				{0}
				'''
			Next:
				'''
				下一成长（{0}）：
				{1}
				'''

			Stage1: {
				Unlock: 开局即可使用
				Summary:
					'''
					第一阶段·相遇与成型：
					四段近战、念动弹射、技能夺取与魔力屏障
					'''
			}

			Stage2: {
				Unlock: 击败骷髅王后解锁
				Summary: 第二阶段·浮游岛与共鸣：解锁多重分体与蝶变共鸣
			}

			Stage3: {
				Unlock: 进入困难模式后解锁
				Summary: 第三阶段·席德兰内战：解锁雷链
			}

			Stage4: {
				Unlock: 击败全部机械三王后解锁
				Summary: 第四阶段·黑天虎之路：解锁压缩居合与雷神之锤
			}
		}

		Skills: {
			TelekineticCatapult: {
				DisplayName: 念动弹射
				UnlockCondition: 默认解锁
				Description:
					'''
					四段剑术始终完整保留；
					根据当前世界进度，
					重新编排念压核、折念刃、
					高速激光与天降星球
					'''
				FirstLayer: 单层：按当前时期运行四刀弹幕编排；未全选时念核集中直射
				AdditionalLayer: 叠层：每层增加一枚念压核
				FullLoadout: 全选：念核散射并获得追踪，形成密集追踪阵列

				CurrentState: {
					Stage0: 单层：一念核｜二延核｜三双核｜四重核
					Stage1: 单层：一念核｜二折刃｜三双核折刃｜四双折刃
					Stage2: 单层：一激光｜二光折刃｜三双光念核｜四重光
					Stage3: 单层：一光念核｜二光双刃｜三双光双核｜四重光双刃
					Stage4: 单层：一光念核｜二光双刃｜三双光双核｜四三星球
				}
			}

			SkillTaker: {
				DisplayName: 技能夺取者
				UnlockCondition: 默认解锁
				Description:
					'''
					剑击命中时施加夺取印记；
					持续攻击会逐渐提高目标易伤，并夺取其碰撞伤害；
					夺取伤害附加至师父面板，最多为当前面板的50%，持续5秒
					每命中一个敌人释放两枚灵弹，每刀最多二十枚；
					灵弹追踪附近最近的敌人，持续命中可刷新印记与夺取伤害
					'''
				FirstLayer: 单层：持续攻击使目标易伤最高提升至1.18倍
				AdditionalLayer: 叠层：易伤提升更快，标记维持更久
				FullLoadout: 全选：易伤倍率上限提升至1.42倍
			}

			MagicBarrier: {
				DisplayName: 魔力屏障
				UnlockCondition: 击败克苏鲁之眼后解锁
				Description:
					'''
					自动生成环绕自身的球形魔力屏障；
					第一层提供10%伤害减免与10点防御，
					后续每层增加5%伤害减免与5点防御；
					基础防御与减伤在屏障破裂后依旧保留；
					屏障存在时，总防御力翻倍；
					第一层拥有5点耐久，每个额外层增加1点耐久上限；
					受到碰撞、弹幕或陷阱等伤害后扣除1点耐久并反击，
					正常享受受击无敌时间，避免连续瞬间扣除耐久；
					受伤后等待3秒，再每1.5秒恢复1点耐久，
					再次受伤会重新计时；耐久耗尽后2.5秒重构；
					全选且屏障存在时，敌人接触伤害减半，生命回复增加35
					'''
				FirstLayer: 单层：减伤10%，防御增加10点，屏障耐久5点；有盾时总防御翻倍
				AdditionalLayer: 叠层：每层增加5%减伤、5点防御与1点屏障耐久上限
				FullLoadout: 全选：屏障存在时接触伤害减半，生命回复增加35
			}

			MultipleBodyCreation: {
				DisplayName: 多重分体
				UnlockCondition: 击败骷髅王后解锁
				Description:
					'''
					四刀依次在身后召唤4、2、4、6个师父分身，
					生成时锁定鼠标方向，起冲前锁定前方20°内敌人并有限追踪；
					命中立即消失并展开蓝色矩阵；
					每刀分身总伤害相同，叠层只提高伤害
					'''
				FirstLayer: 单层：四刀依次召唤4／2／4／6个分身
				AdditionalLayer: 叠层：只提高分身伤害，数量不变
				FullLoadout: 全选：分体突进速度更快
			}

			BlueResonance: {
				DisplayName: 蝶变共鸣
				UnlockCondition: 击败血肉墙后解锁
				Description:
					'''
					剑击命中时迸发亮蓝色共鸣蝴蝶；
					有玩家受伤时追踪玩家并治疗，
					全员满血时追踪敌人造成伤害
					'''
				FirstLayer: 单层：命中释放可治疗或伤敌的共鸣蝴蝶
				AdditionalLayer: 叠层：每层增加一只共鸣蝴蝶
				FullLoadout: 全选：每次挥刀都会释放共鸣蝴蝶，无需命中敌人
			}

			ThunderChain: {
				DisplayName: 雷链
				UnlockCondition: 击败任意一个机械Boss后解锁
				Description:
					'''
					第一刀布置电路，后续三刀降下多道闪电；
					每道雷分别标记一个敌人，目标不足时落向周围空处；
					落点产生范围爆炸，同一爆炸对每个敌人只造成一次伤害；
					第四刀进一步增加雷数
					'''
				FirstLayer: 单层：挥剑召来雷链与追踪落雷
				AdditionalLayer: 叠层：增加伴随雷和追踪目标数量
				FullLoadout: 全选：闪电替换为更宽的树状落雷，并提高伤害
			}

			PressurizedQuickdraw: {
				DisplayName: 压缩居合
				UnlockCondition: 击败世纪之花后解锁
				Description:
					'''
					四段剑术沿剑弧留下压缩爆点；
					全选后四段剑术化为持续刀盘，
					按住左键永续回旋，松开后惯性停转
					'''
				FirstLayer: 单层：剑弧引爆压缩空气
				AdditionalLayer: 叠层：提高压缩爆点伤害
				FullLoadout: 全选：持续挥舞大剑，聚合体大幅延长，击杀敌人回复生命值
			}

			ThorsHammer: {
				DisplayName: 雷神之锤
				UnlockCondition: 击败石巨人后解锁
				Description:
					'''
					四段剑术完整进行两轮后，
					在头顶随机位置召唤法阵，雷神之锤逐渐显形并旋转蓄力；
					出锤瞬间锁定鼠标最近的可攻击敌人，优先选择可攻击的Boss。
					若全部可用槽均为雷神之锤，
					则完成一轮四刀即可释放；
					雷神之锤从法阵飞向目标，命中时向四周迸发蓝色雷电
					并引发大范围雷陨冲击；视野内无有效目标时砸向出锤瞬间的鼠标位置；下雨时锤击伤害翻倍
					'''
				FirstLayer: 单层：完成两轮四刀后召唤雷神之锤
				AdditionalLayer: 叠层：提高雷神之锤伤害
				FullLoadout: 全选：缩短锤击间隔
			}
		}

