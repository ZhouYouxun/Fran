Mods: {
	Fran: {
		Items: {
			FransHeadwear: {
				DisplayName: 弗兰的头饰
				Tooltip:
					'''
					将本物品放在背包中并标记为收藏，即可进入“弗兰人物模式”
					效果与把角色命名为“Fran / フラン / 弗兰”完全相同
					开启弗兰外观框架、黑猫族战士本能、冲刺、黑天虎大招与师父系统
					测试版暂时使用原版猫耳图标
					'''
			}

			Teacher: {
				DisplayName: 师父
				Tooltip:
					'''
					与弗兰绑定的传奇智慧武器
					持续左键：循环使用横向扫斩、反身上挑、突进刺击与沉重斩落
					按住右键打开术式轮盘，在目标扇区松开右键即可把术式嵌入四段剑术
					按[c/C3B2F5:魔石回廊]（默认J）分配通过Boss战获得的自我进化点
					在轮盘中央松开右键可卸下术式；未装备术式时使用纯粹四段剑术
					大招能量会在三分钟内自动充满；满值后按[c/8CDFFF:大招]（默认G）立即发动连续斩杀
					手持其他武器时，师父会漂浮在弗兰身后，不会禁用其他职业
					非弗兰人物只要实际持有师父，也可以使用左键连段和右键技能；人物被动仍只属于弗兰模式
					师父不能丢弃、出售、研究、放入垃圾桶或留在仓库；建立绑定后会永久召回
					武器伤害与可用技能会随世界流程成长
					'''
			}

			TeacherExcavationTool: {
				DisplayName: 师父·开拓形态
				Tooltip:
					'''
					师父将自身塑造成适合开拓的工具形态
					左键作为镐使用；右键作为锤斧使用
					支持自动连续使用与原版智能光标
					性能随世界流程成长，但不会释放师父的战斗技能
					首次与师父建立绑定时自动获得
					'''
			}

			VanillaBossProgressAdjuster: {
				DisplayName: 原版Boss进度调整器
				Tooltip:
					'''
					开发工具：使用后打开仅包含原版Boss的进度面板
					点击头像可设置或清除当前世界的击败标记；底部按钮可批量调整阶段
					多人模式的修改请求由服务器校验并执行
					本工具只修改流程标记，不会逆转世界已经发生的永久地形转化
					'''
			}
		}

		ToolProgression: {
			Current: 当前阶段：{0} | 镐力 {1} · 斧力 {2}% · 锤力 {3} · 距离 +{4} · 使用时间 {5}
			Next: 下一次成长：{0}
			FinalStage: 已达到最终开拓形态

			Stages: {
				Stage0: 初始形态
				Stage1: 邪恶矿脉适应
				Stage2: 地牢开拓
				Stage3: 困难模式重构
				Stage4: 机械解析
				Stage5: 丛林共鸣
				Stage6: 神庙破拆
				Stage7: 月面终型
			}

			Unlocks: {
				Stage1: 击败世界吞噬怪或克苏鲁之脑
				Stage2: 击败骷髅王
				Stage3: 击败血肉墙并进入困难模式
				Stage4: 击败全部三个机械Boss
				Stage5: 击败世纪之花
				Stage6: 击败石巨人
				Stage7: 击败月亮领主
			}
		}

		Buffs: {
			BlackCatWarriorBuff: {
				DisplayName: 黑猫族的战士本能
				Description: 免疫摔落、获得夜视，近战伤害与攻击速度各提高10%
			}
		}

		Keybinds: {
			SkillWheel.DisplayName: 师父技能轮
			PotentialRelease.DisplayName: 黑天虎·绝闪
			FranDash.DisplayName: 弗兰冲刺
			MagicStoneCorridor.DisplayName: 师父的魔石回廊
		}

		UI: {
			UltimateCharge: 黑天虎：{0}%
			UltimateReady: 黑天虎·绝闪 READY
			PureSwordsmanship: 解除战术附着
			PureSwordsmanshipDescription: 解除当前战术模块；四段师父剑术始终保留，不会被任何技能替换
		}

		BossProgress: {
			Title: 原版Boss进度调整器
			Defeated: 已击败
			Undefeated: 未击败
			EntryHint: "{0} · {1}；点击切换"

			Buttons: {
				PreHardmode: 肉前
				Hardmode: 困难模式
				All: 全部
				Invert: 反转
			}

			ButtonHints: {
				PreHardmode: 批量设置或清除全部原版肉前Boss标记
				Hardmode: 批量设置或清除全部原版困难模式Boss标记
				All: 批量设置或清除全部原版Boss标记
				Invert: 反转每一个独立的原版Boss标记
			}

			Names: {
				KingSlime: 史莱姆王
				EyeOfCthulhu: 克苏鲁之眼
				EaterOfWorlds: 世界吞噬怪
				BrainOfCthulhu: 克苏鲁之脑
				QueenBee: 蜂王
				Skeletron: 骷髅王
				Deerclops: 独眼巨鹿
				WallOfFlesh: 血肉墙
				QueenSlime: 史莱姆皇后
				Destroyer: 毁灭者
				Twins: 双子魔眼
				SkeletronPrime: 机械骷髅王
				Plantera: 世纪之花
				Golem: 石巨人
				DukeFishron: 猪龙鱼公爵
				EmpressOfLight: 光之女皇
				LunaticCultist: 拜月教邪教徒
				MoonLord: 月亮领主
			}
		}

		Notices: {
			IntroTitle: 【弗兰人物模式已启动：师父已经回到你身边】
			IntroCombat: 持续左键使用四段大剑连击；手持其他武器时，师父会浮在身后
			IntroSkills: 按住右键打开术式轮盘，在目标扇区松开右键装备术式；术式会自动嵌入四段剑术
			IntroEvolution: 实际参与Boss击杀可吸收独立魔石；按J打开魔石回廊，决定师父、弗兰与师徒共鸣的长期进化方向
			IntroDash: 已绑定弗兰冲刺键时仅按该键冲刺；未绑定时双击左右方向键冲刺；其他装备冲刺优先
			IntroPotential: 大招能量会随在线时间自动积攒三分钟；满值后按G立即发动黑天虎连续斩杀
		}

		Abilities: {
			Dash: {
				Line: "【冲刺】当前进度：{0}｜{1}｜效果：{2}"
				Progress: 开局解锁
				Effect: 速度16、持续12帧、基础冷却50帧；冲刺期间人物翻滚两圈
				States: {
					Enabled: 已开启：未装备其他冲刺
					Overridden: 已关闭：检测到外部冲刺，外部装备优先
					InactiveFranMode: 已关闭：当前未进入弗兰人物模式
				}
			}

			Flight: {
				Line: "【念动飞行】当前进度：{0}｜{1}｜效果：{2}"
				Progress: {
					Locked: 肉山前·尚未解锁
					Tier1: 困难模式·念动起飞
					Tier2: 三机械首领后·动力重构
					Tier3: 世纪之花后·悬停掌握
					Tier4: 石巨人后·念动终型
					Infinite: 光之女皇后·无限飞行
				}
				States: {
					Enabled: 已开启：未装备功能翅膀
					Overridden: 已关闭：检测到功能翅膀，装备翅膀优先
					Mounted: 已暂停：坐骑状态不叠加念动飞行
					Locked: 未解锁：进入困难模式后自动获得
					InactiveFranMode: 已关闭：当前未进入弗兰人物模式
				}
				Effects: {
					Locked: 进入困难模式后视为自带一对翅膀
					Finite: "飞行{0}帧（{1:0.00}秒），水平速度{2}，加速度倍率{3}{4}"
					Infinite: "无限飞行，水平速度{2}，加速度倍率{3}{4}"
					Hover: ，按住下键可悬停
					NoHover: ""
				}
			}
		}

		Evolution: {
			Title: 魔石回廊·自我进化
			OpenHint: 打开魔石回廊（默认J）
			Tooltip: 魔石回廊：{0}点可用 / 已吸收{1}枚Boss魔石；按J分配
			PointSummary: 可用 {0}　已投入 {1}　已吸收 {2}　当前阶段上限 {3}
			Overview: 击败并实际参与Boss战可吸收一枚独立魔石。三条路线只塑造基础剑术、弗兰冲刺与师徒配合，不改变战术技能组和黑天虎大招。
			MagicStoneAcquired: 获得魔石刻印·自我进化点 +1
			NodeUnlocked: 自我进化：{0}
			ResetHold: 长按洗点（免费）
			ResetEmpty: 尚未投入进化点
			ResetLocked: 战斗中不能洗点

			Branches: {
				Teacher: 师父·自我进化
				Fran: 弗兰·黑猫进化
				Bond: 师徒·共鸣
			}

			Status: {
				None: 点击吸收此进化（Boss战和大招期间不可操作）
				Active: 已吸收并生效
				AlreadyUnlocked: 已吸收
				MissingPrerequisite: 需要先吸收前置进化
				StageLocked: 需要到达人物成长第{0}阶段
				NotEnoughPoints: 自我进化点不足；继续挑战新的Boss
				InCombat: Boss战、大招或死亡期间不能调整魔石回廊
				InvalidNode: 无效的进化节点
			}

			Nodes: {
				EdgeCalibration: {
					DisplayName: 锋刃校准
					Description: 师父本体剑刃的攻击距离与判定范围提高6%；不强化技能弹幕。
				}

				ComboCalculation: {
					DisplayName: 连击演算
					Description: 按顺序命中四段基础剑术时，下一段剑刃直击伤害依次提高3%、6%、9%；中断后重置。
				}

				MagicStoneAnalysis: {
					DisplayName: 魔石解析
					Description: 6秒内以四段基础剑术依次命中同一Boss，使其被解析8秒；剑刃直击获得12点护甲穿透。
				}

				SelfEvolution: {
					DisplayName: 自我进化
					Description: 完成四段剑刃直击后储存一次进化回响；下一轮第一剑追加50%伤害的近距离剑影，且不会触发战术术式。
				}

				CatStep: {
					DisplayName: 猫步
					Description: 弗兰冲刺冷却由50帧降至42帧；冲刺期间暂停基础连击的中断计时。
				}

				AerialHunt: {
					DisplayName: 立体狩猎
					Description: 主动冲刺键支持八方向冲刺：优先采用方向输入，无输入时指向鼠标；双击方向键仍保持水平冲刺。
				}

				HuntingTempo: {
					DisplayName: 猎场连携
					Description: 冲刺接触敌人后储存一次猎手节奏；下一次师父本体挥砍的持续时间缩短12%。
				}

				EvolvedFootwork: {
					DisplayName: 进化之足
					Description: 冲刺命中新目标时返还当前剩余冷却的60%；同一敌人180帧内只能触发一次。
				}

				MindSync: {
					DisplayName: 心念同步
					Description: 基础四段连击的中断时间由70帧延长至105帧。
				}

				SharedRhythm: {
					DisplayName: 共同步调
					Description: 按顺序进入第四段基础剑术时，该段挥剑持续时间缩短12%。
				}

				ResonantPull: {
					DisplayName: 共鸣牵引
					Description: 师父本体剑刃命中普通敌人时，将其小幅拉向剑锋；Boss和完全抗击退目标不受影响。
				}

				OneAsSword: {
					DisplayName: 人剑一体
					Description: 不受伤完成四段剑刃直击后，基础挥剑速度与剑刃范围提高10%，持续5秒；受伤立即结束。
				}
			}
		}

		Configs: {
			FranClientConfig: {
				DisplayName: 弗兰客户端设置

				HideUltimateGauge: {
					Label: 隐藏黑天虎大招能量条
					Tooltip: 大招能量条默认显示在屏幕最顶端中央；仅在不想显示时开启此项
				}

				AllowUltimateGaugeDragging: {
					Label: 允许拖动大招能量条
					Tooltip: 默认关闭；开启后可用鼠标左键直接拖动能量条，位置会随角色存档保存
				}
			}
		}

		Stages: {
			Current: 当前成长：{0}
			Next: 下一成长（{0}）：{1}

			Stage1: {
				Unlock: 开局即可使用
				Summary: 第一阶段·相遇与成型：四段近战、念动弹射、技能夺取与魔力屏障
			}

			Stage2: {
				Unlock: 击败骷髅王后解锁
				Summary: 第二阶段·浮游岛与共鸣：解锁多重分体与蓝辉共鸣
			}

			Stage3: {
				Unlock: 进入困难模式后解锁
				Summary: 第三阶段·席德兰内战：解锁雷链
			}

			Stage4: {
				Unlock: 击败全部机械三王后解锁
				Summary: 第四阶段·黑天虎之路：解锁压缩居合与雷神之锤
			}
		}

		Skills: {
			TelekineticCatapult: {
				DisplayName: 念动弹射
				Description: 四段剑术完整保留；前三刀分别平行射出2、3、4枚念动炮弹，第四刀改为无限穿透的指向激光。困难模式后每刀额外从上空投下2至3颗星球；星球先减速再逐渐加速，命中敌人或物块后爆炸
			}

			SkillTaker: {
				DisplayName: 技能夺取者
				Description: 仅剑击命中时触发紫色术式爆发并叠加夺取层数；每次额外分裂两枚先散开、再追敌的紫色灵弹，最多四层，每层使后续剑击伤害提高10%
			}

			MagicBarrier: {
				DisplayName: 魔力屏障
				Description: 自动生成环绕自身的双层魔力屏障；承受攻击时减免28%伤害、消耗一次耐久并释放反击冲击，五次后破裂并短暂重构
			}

			MultipleBodyCreation: {
				DisplayName: 多重分体
				Description: 每次挥剑都在身后列阵两名师父幻影，短暂停驻后锁定鼠标附近目标高速突进；第四刀改为四名幻影错时齐射
			}

			BlueResonance: {
				DisplayName: 蓝辉共鸣
				Description: 每次剑击命中都会留下延迟复写的蓝色共鸣剑痕；第四刀产生三重和弦，共鸣命中可周期性恢复生命
			}

			ThunderChain: {
				DisplayName: 雷链
				Description: 每次挥剑都从鼠标上空降下多道远古闪电；鼠标附近存在敌人时，还会在最多三个目标头顶追加自动雷击，第四刀进一步增加雷数
			}

			PressurizedQuickdraw: {
				DisplayName: 压缩居合
				Description: 每次挥剑都会释放使用泰拉刃光波形态的高压气功波；光波无限贯穿并逐渐减速，第四刀改为更小、更快、更集中的终结波
			}

			ThorsHammer: {
				DisplayName: 雷神之锤
				Description: 四段剑术完整进行两轮后，第二轮第四刀锁定鼠标附近最近的敌人；召唤法阵持续附着目标，随后雷神之锤高速追落并引发大范围雷陨冲击
			}
		}

